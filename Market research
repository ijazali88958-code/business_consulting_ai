
from crewai import Agent


def create_agent(llm):
    return Agent(
        role="Market Research Consultant",
        goal=(
            "Analyze the target market, customer needs, "
            "competitors, opportunities, and market barriers."
        ),
        backstory=(
            "You are an analytical market research consultant. "
            "You distinguish verified facts from assumptions "
            "and never invent statistics or sources."
        ),
        llm=llm,
        verbose=False,
        allow_delegation=False,
    )
